{
  "name": "@exortek/oauth2",
  "version": "0.0.0",
  "description": "OAuth 2.1 for Node.js 22+ — both halves, secure by default. The relying-party flow (createOAuth + provider presets, mandatory PKCE / state / nonce / iss) and a full authorization server (DPoP incl. nonce, PAR, JAR/JARM, resource indicators, device grant, token exchange, FAPI 2.0) over JWT or PASETO. Server-only, zero-dependency, built on node:crypto.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./express": {
      "types": "./dist/middleware/express.d.ts",
      "import": "./dist/express.mjs",
      "require": "./dist/express.cjs"
    },
    "./fastify": {
      "types": "./dist/middleware/fastify.d.ts",
      "import": "./dist/fastify.mjs",
      "require": "./dist/fastify.cjs"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.mjs",
      "require": "./dist/server/index.cjs"
    },
    "./server/express": {
      "types": "./dist/server/middleware/express.d.ts",
      "import": "./dist/server/express.mjs",
      "require": "./dist/server/express.cjs"
    },
    "./server/fastify": {
      "types": "./dist/server/middleware/fastify.d.ts",
      "import": "./dist/server/fastify.mjs",
      "require": "./dist/server/fastify.cjs"
    },
    "./providers/google": {
      "types": "./dist/providers/google.d.ts",
      "import": "./dist/providers/google.mjs",
      "require": "./dist/providers/google.cjs"
    },
    "./providers/github": {
      "types": "./dist/providers/github.d.ts",
      "import": "./dist/providers/github.mjs",
