{
  "name": "@exortek/oauth2",
  "version": "0.0.0",
  "description": "OAuth 2.1 for Node.js 22+ — authorization-code + PKCE (S256), state / nonce CSRF protection, and provider presets. The security-critical flow bits are built in, not left to the caller. Server-only, zero-dependency, built on node:crypto.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist tsconfig.tsbuildinfo && rollup -c rollup.config.js && tsc -p tsconfig.json",
    "build:watch": "rollup -c rollup.config.js --watch",
    "build:types": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test 'tests/**/*.test.js'",
    "test:coverage": "node --test --experimental-test-coverage 'tests/**/*.test.js'",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "prepack": "cp ../../LICENSE ./LICENSE"
  },
  "keywords": [
    "backend",
    "security",
    "oauth",
    "oauth2",
    "oauth2.1",
    "pkce",
    "authorization-code",
    "sso",
    "social-login",
    "authentication",
    "node-crypto"
  ],
  "license": "MIT",
  "homepage": "https://github.com/ExorTek/auth/tree/master/packages/oauth2#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ExorTek/auth.git",
    "directory": "packages/oauth2"
  },
  "bugs": {
    "url": "https://github.com/ExorTek/auth/issues"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
