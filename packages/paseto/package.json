{
  "name": "@exortek/paseto",
  "version": "1.0.0",
  "description": "PASETO (Platform-Agnostic Security Tokens) for Node.js 22+. v4.local (XChaCha20 + keyed BLAKE2b) + v4.public (Ed25519). Purpose is bound into the token — no algorithm-confusion attacks. Server-only, zero-dependency, built on node:crypto.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./token-pair": {
      "types": "./dist/token-pair.d.ts",
      "import": "./dist/token-pair.mjs",
      "require": "./dist/token-pair.cjs"
    },
    "./stores": {
      "types": "./dist/stores.d.ts",
      "import": "./dist/stores.mjs",
      "require": "./dist/stores.cjs"
    }
  },
  "files": [
    "dist",
    "/README.md",
    "/CHANGELOG.md",
    "/LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist tsconfig.tsbuildinfo && rollup -c rollup.config.js && tsc -p tsconfig.json",
    "build:watch": "rollup -c rollup.config.js --watch",
    "build:types": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test 'tests/**/*.test.js'",
    "test:coverage": "node --test --experimental-test-coverage 'tests/**/*.test.js'",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "prepack": "cp ../../LICENSE ./LICENSE"
  },
  "keywords": [
    "backend",
    "security",
    "paseto",
    "token",
    "v4",
    "xchacha20-poly1305",
    "ed25519",
    "authentication",
    "stateless",
    "node-crypto"
  ],
  "license": "MIT",
  "homepage": "https://github.com/ExorTek/auth/tree/master/packages/paseto#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ExorTek/auth.git",
    "directory": "packages/paseto"
  },
  "bugs": {
    "url": "https://github.com/ExorTek/auth/issues"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
