# Dependencies
node_modules/

# Build artifacts
dist/
*.tsbuildinfo
**.next/
web/public/_pagefind/

# Yarn (Berry) — keep cache/install state out
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
.pnp.*

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Coverage
coverage/
.nyc_output/
lcov.info

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Env
.env
.env.*
!.env.example

# npm pack output (yarn npm pack, yarn pack)
*.tgz

# This is a Yarn repo — only yarn.lock is committed. Block the other
# package managers' lockfiles from ever landing (preinstall enforces yarn).
package-lock.json
pnpm-lock.yaml
npm-shrinkwrap.json


# Claude Code / personal working notes
/.claude
skills-lock.json
ARCHITECTURE-local.md
CLAUDE.md
PLAN.md
REPORT.md

# LICENSE files are generated per-package at `npm pack` time from root LICENSE
# via each package's `prepack` script — do not track the copies.
packages/*/LICENSE
